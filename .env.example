# Kopieer naar .env.local voor lokaal ontwikkelen. Echte waarden alleen in Vercel env vars / .env.local, nooit committen.
APP_URL=http://localhost:3000
DATABASE_URL=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE_URL=https://www.strava.com/oauth
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optioneel: na `pnpm strava:subscribe`, zodat webhook-events van andere subscriptions worden genegeerd
STRAVA_SUBSCRIPTION_ID=
# Komma-gescheiden Strava athlete-id's die mogen inloggen (leeg = iedereen)
ALLOWED_ATHLETE_IDS=

# Genereer met `pnpm gen:secrets`
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
